+// ---- screenshots: sdmc:/switch/vpnx/media/<table file name>.jpg|jpeg|png (where the player saves it) ----
+std::string Lower(std::string s);
+
+std::vector<std::pair<std::string, std::string>> g_media; // lower-case stem, full path
+
+bool IsImageName(const std::string& lower, std::string& stem)
+{
+   for (const char* ext : { ".jpg", ".jpeg", ".png" }) {
+      const size_t n = strlen(ext);
+      if (lower.size() > n && lower.compare(lower.size() - n, n, ext) == 0) {
+         stem = lower.substr(0, lower.size() - n);
+         return true;
+      }
+   }
+   return false;
+}
+
+void IndexMedia()
+{
+   g_media.clear();
+   if (DIR* d = opendir("/switch/vpnx/media")) {
+      while (const dirent* e = readdir(d)) {
+         std::string stem;
+         const std::string lower = Lower(e->d_name);
+         if (e->d_name[0] != '.' && IsImageName(lower, stem))
+            g_media.emplace_back(stem, std::string("/switch/vpnx/media/") + e->d_name);
+      }
+      closedir(d);
+   }
+}
+
+// the image of a table: the same name as the table (any case), else an image whose name is part of the table's (or the other way round,
+// at least 5 characters, the longest wins), else an image next to the table
+std::string FindShot(const std::string& name, const std::string& dir)
+{
+   const std::string lname = Lower(name);
+   for (const auto& m : g_media)
+      if (m.first == lname)
+         return m.second;
+   const std::pair<std::string, std::string>* best = nullptr;
+   for (const auto& m : g_media)
+      if (m.first.size() >= 5 && lname.size() >= 5 && (lname.find(m.first) != std::string::npos || m.first.find(lname) != std::string::npos))
+         if (!best || m.first.size() > best->first.size())
+            best = &m;
+   if (best)
+      return best->second;
+   for (const char* ext : { ".jpg", ".jpeg", ".png" }) {
+      const std::string shot = dir + "/" + name + ext;
+      if (access(shot.c_str(), F_OK) == 0)
+         return shot;
+   }
+   return std::string();
+}
+
+void ScanTables(const std::string& dir, int depth, std::vector<Table>& out)
+{
+   DIR* d = opendir(dir.c_str());
+   if (!d)
+      return;
+   while (const dirent* e = readdir(d)) {
+      if (e->d_name[0] == '.')
+         continue;
+      const std::string path = dir + "/" + e->d_name;
+      const size_t n = strlen(e->d_name);
+      if (n > 4 && strcasecmp(e->d_name + n - 4, ".vpx") == 0) {
+         Table t;
+         t.path = path;
+         t.dir = dir;
+         t.name = std::string(e->d_name, n - 4);
+         t.shot = FindShot(t.name, dir);
+         out.push_back(std::move(t));
+      } else if (depth > 0 && e->d_type == DT_DIR) {
+         static const char* skip[] = { "assets", "plugins", "pinmame", "cache", "prefs", "scripts", "nvram", "cfg", "roms", "music" };
+         bool skipIt = false;
+         for (const char* s : skip)
+            skipIt = skipIt || strcasecmp(e->d_name, s) == 0;
+         if (!skipIt)
+            ScanTables(path, depth - 1, out);
+      }
+   }
+   closedir(d);
+}
