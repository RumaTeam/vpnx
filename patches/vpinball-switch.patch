+void Present(Framebuffer* fb)
+{
+   u32 stride = 0;
+   uint8_t* buf = static_cast<uint8_t*>(framebufferBegin(fb, &stride));
+   for (int y = 0; y < kH; y++)
+      memcpy(buf + static_cast<size_t>(y) * stride, static_cast<uint8_t*>(g_canvas->pixels) + static_cast<size_t>(y) * g_canvas->pitch, kW * 4);
+   framebufferEnd(fb);
+}
+
+// ---- applet-mode gate (as in Ruma): the player needs Application mode (all of the console's memory). Offers the forwarder: an icon in
+// the HOME game list that always opens the VPNX in Application mode. Yes creates it and closes; No closes; Y goes on anyway. ----
+int WrapText(const std::string& text, int size, int maxW, std::vector<std::string>& lines)
+{
+   std::string cur;
+   size_t p = 0;
+   while (p < text.size()) {
+      size_t sp = text.find(' ', p);
+      if (sp == std::string::npos)
+         sp = text.size();
+      const std::string word = text.substr(p, sp - p);
+      const std::string cand = cur.empty() ? word : cur + " " + word;
+      if (!cur.empty() && TextWidth(cand, size, false) > maxW) {
+         lines.push_back(cur);
+         cur.clear();
+         continue;
+      }
+      cur = cand;
+      p = sp + 1;
+   }
+   if (!cur.empty())
+      lines.push_back(cur);
+   return static_cast<int>(lines.size());
+}
+
+void DrawGate(int focus, const std::vector<std::string>& paras, const char* btnA, const char* btnB, const char* hint)
+{
+   Fill(0, 0, kW, kH, cBg);
+   const int cw = 780, pad = 32, textW = cw - 2 * pad;
+   std::vector<std::vector<std::string>> wrapped;
+   int th = 0;
+   for (const auto& para : paras) {
+      wrapped.emplace_back();
+      th += WrapText(para, 15, textW, wrapped.back()) * 24 + 12;
+   }
+   const int head = 36 + 18;
+   const int bh = 44;
+   const int ch = pad + head + th + (btnA ? bh + 20 : 0) + pad;
+   const int x = (kW - cw) / 2, y = (kH - ch) / 2;
+   FillRR(x, y, cw, ch, 10, cChrome);
+   for (int i = 0; i < 30; i++)
+      FillRR(x + pad + (i % 5) * 6, y + pad + (i / 5) * 6, 5, 5, 1, kLogoShape[i] == '0' ? 0x1F2733 : (kLogoShape[i] == '2' ? cHi : cAccent));
+   Text(x + pad + 44, y + pad, 34, Tr("Open VPNX in Application mode"), 22, cText, true, 0, textW - 50);
+   int ty = y + pad + head;
+   for (size_t i = 0; i < wrapped.size(); i++) {
+      for (const auto& line : wrapped[i]) {
+         Text(x + pad, ty, 24, line, 15, i == 0 ? cText : cRow);
+         ty += 24;
+      }
+      ty += 12;
+   }
+   if (btnA) {
+      const int bw = 190, by = y + ch - pad - bh, gap = 14;
+      const int bxB = x + cw - pad - bw, bxA = bxB - gap - bw;
+      const char* labels[2] = { btnA, btnB };
+      const int bxs[2] = { bxA, bxB };
+      for (int i = 0; i < (btnB ? 2 : 1); i++) {
+         const int bx = btnB ? bxs[i] : bxB;
+         const bool on = btnB ? focus == i : true;
+         FillRR(bx, by, bw, bh, 6, on ? cAccent : cControl);
+         Text(bx + bw / 2, by, bh, labels[i], 16, on ? cOnAccent : cRow, true, 2);
+      }
+      if (hint)
+         Text(x + pad, by, bh, hint, 11, cDim, false, 0, textW - 2 * bw - gap - 10);
+   }
+}
