diff --git a/plugins/pinmame/Controller.cpp b/plugins/pinmame/Controller.cpp
index 8b17a1e..36bd6b7 100644
--- a/plugins/pinmame/Controller.cpp
+++ b/plugins/pinmame/Controller.cpp
@@ -273,9 +273,22 @@ void Controller::Stop()
 
    // Always request PinMAME to stop (even if not running) as it also performs memory cleanup
    const bool wasRunning = PinmameIsRunning() != 0;
+#ifdef __SWITCH__
+   LOGI(std::format("[exit] PinMAME: stopping (running={})", wasRunning ? 1 : 0));
+#endif
    PinmameStop();
+   int waited = 0;
    while (PinmameIsRunning() != 0) // Wait until the machine is stopped
+   {
       std::this_thread::sleep_for(std::chrono::milliseconds(75));
+#ifdef __SWITCH__
+      if (++waited % 13 == 0) // about once a second
+         LOGI(std::format("[exit] PinMAME: still waiting for the game thread to stop ({} ms)", waited * 75));
+#endif
+   }
+#ifdef __SWITCH__
