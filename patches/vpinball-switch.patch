+// Options of /ruma/runners/vpnx/options.json (see docs/ruma/) -> settings of the game.
+//
+// Every option is a row of kRumaOptionMaps: the value chosen in Ruma (a string of options.json) -> the number(s) written to one or
+// more Visual Pinball settings (VPinballX.ini). "auto" (the default of every option) writes nothing: the menu / ini decides.
+//
+// The VPinballSave* calls persist to the ini, so a value written for one table would leak into the next table that says "auto".
+// To keep the options per table, each value Ruma writes is recorded (the value found before, the value written) in
+// sdmc:/switch/vpnx/ruma_applied.json and put back at the next start, before the new session is applied. A setting the player
+// changed afterwards in the game menu no longer holds the value Ruma wrote and is left alone.
+enum class SetKind { Int, Float, Bool };
+struct RumaSettingRef
+{
+   const char* section;
+   const char* key;
+   SetKind kind;
+};
+struct RumaOptionValue
+{
+   const char* value;
+   std::vector<double> nums; // one number for all the targets, or one per target
+};
+struct RumaOptionMap
+{
+   const char* id;
+   std::vector<RumaSettingRef> targets;
+   std::vector<RumaOptionValue> values;
+};
