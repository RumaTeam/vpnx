+// ---- screen pieces ----
+void Glyph(int& x, int y, const std::string& label, bool active)
+{
+   const int w = std::max(18, TextWidth(label, 11, true) + 10);
+   FillRR(x, y, w, 18, 9, active ? cAccent : cGlyph);
+   Text(x + w / 2, y, 18, label, 11, active ? cOnAccent : cText, true, 2);
+   x += w;
+}
+
+void Header(size_t count, const std::string& modeBadge, unsigned battery)
+{
+   Fill(0, 0, kW, 36, cChrome);
+   Fill(0, 35, kW, 1, cLine);
+   // the mark (docs/brand): table rails, the flipper V and the ball, in a 5x6 grid of 3 px tiles with a 1 px gap like Ruma's R
+   static const char kLogo[] = "10001" "10001" "10201" "01010" "01010" "00100";
+   for (int i = 0; i < 30; i++) {
+      if (kLogo[i] == '0')
+         continue;
+      FillRR(14 + (i % 5) * 4, 6 + (i / 5) * 4, 3, 3, 1, kLogo[i] == '2' ? cHi : cAccent);
+   }
+   Text(41, 0, 36, "VPNX", 15, cHi, true);
+   // tabs: the only one is the table list
+   const std::string tab = Tr("Tables");
+   const int tw = TextWidth(tab, 13, true) + 20;
+   FillRR(108, 6, tw, 24, 4, cTabBg);
+   Text(108 + tw / 2, 6, 24, tab, 13, cHi, true, 2);
+   Text(108 + tw + 14, 0, 36, std::to_string(count) + " " + Tr(count == 1 ? "table" : "tables"), 12, cDim);
+   // right side: mode badge, battery
+   int x = kW - 14;
+   char bat[16];
+   snprintf(bat, sizeof bat, "bat %u%%", battery);
+   Text(x, 0, 36, bat, 12, cMid, false, 1);
+   x -= TextWidth(bat, 12, false) + 18;
+   const int bw = TextWidth(modeBadge, 11, false) + 16;
+   Fill(x - bw, 8, bw, 20, cGlyph);
+   Fill(x - bw + 1, 9, bw - 2, 18, cChrome);
+   Text(x - bw / 2, 8, 20, modeBadge, 11, cMid, false, 2);
+}
+
+void Footer(const std::string& pos, const std::vector<std::pair<std::string, std::string>>& hints)
+{
+   Fill(0, 688, kW, 32, cChrome);
+   Fill(0, 688, kW, 1, cLine);
+   Text(14, 688, 32, pos, 11, cLabel);
+   // from the right: the last hint (the primary one) is drawn first
+   int x = kW - 14;
+   for (int i = static_cast<int>(hints.size()) - 1; i >= 0; i--) {
+      const bool primary = i == static_cast<int>(hints.size()) - 1;
+      const std::string& label = hints[i].second;
+      const int lw = TextWidth(label, 12, primary);
+      x -= lw;
+      Text(x, 688, 32, label, 12, primary ? cHi : cMid, primary);
+      x -= 5;
+      // glyph(s): "L R" style pairs are written with a space
+      std::string keys = hints[i].first;
+      std::vector<std::string> parts;
+      size_t p = 0;
+      while (p < keys.size()) {
+         const size_t q = keys.find(' ', p);
+         parts.push_back(keys.substr(p, q == std::string::npos ? std::string::npos : q - p));
+         if (q == std::string::npos)
+            break;
+         p = q + 1;
+      }
+      int total = 0;
+      for (const auto& k : parts)
+         total += std::max(18, TextWidth(k, 11, true) + 10) + 2;
+      x -= total;
+      int gx = x;
+      for (const auto& k : parts) {
+         Glyph(gx, 688 + 7, k, primary);
+         gx += 2;
+      }
+      x -= 16;
+   }
+}
