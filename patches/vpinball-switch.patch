diff --git a/src/renderer/BgfxScopeProfiler.h b/src/renderer/BgfxScopeProfiler.h
new file mode 100644
index 0000000..a9be378
--- /dev/null
+++ b/src/renderer/BgfxScopeProfiler.h
@@ -0,0 +1,123 @@
+// license:GPLv3+
+//
+// Collects the bgfx profiler scopes (BGFX_CONFIG_PROFILER=1 builds of bgfx: BGFX_PROFILER_SCOPE regions in the renderers) into
+// a table of {count, total time} per region, to tell where the CPU time of the render thread goes. bgfx calls the scope
+// callbacks from its API/render thread only, so the table is written by one thread; another thread reads it for reporting
+// (racy by design: diagnostics only) and asks for a restart through RequestReset().
+#pragma once
+
+#include <atomic>
+#include <chrono>
+#include <cstdint>
+#include <cstdio>
+#include <string>
+#include <algorithm>
+#include <vector>
+
+class BgfxScopeProfiler final
+{
+public:
+   void Begin(const char* name, uint16_t line)
+   {
+      if (m_reset.exchange(false, std::memory_order_relaxed))
+         ClearTable();
+      if (m_depth >= kMaxDepth)
+      {
+         ++m_depth;
+         return;
+      }
+      m_stack[m_depth++] = { Find(name, line), Now() };
+   }
+
+   void End()
+   {
+      if (m_depth == 0)
+         return;
+      --m_depth;
+      if (m_depth >= kMaxDepth)
+         return;
+      const Frame& f = m_stack[m_depth];
+      if (f.entry < 0)
+         return;
+      Entry& e = m_entries[f.entry];
+      e.count++;
+      e.totalNs += Now() - f.start;
+   }
+
+   void RequestReset() { m_reset.store(true, std::memory_order_relaxed); }
+
+   // "region: calls/frame x ms/frame" for the most expensive regions, per rendered frame (frames = calls of the frame scope)
+   std::string Report(const char* frameScopeName, size_t top = 14) const
+   {
+      uint32_t frames = 0;
+      std::vector<const Entry*> sorted;
+      for (int i = 0; i < m_numEntries; i++)
+      {
+         const Entry& e = m_entries[i];
+         if (e.name == nullptr || e.count == 0)
+            continue;
+         if (std::string_view(e.name) == frameScopeName)
+            frames = e.count;
+         sorted.push_back(&e);
+      }
+      if (frames == 0)
+         frames = 1;
+      std::ranges::sort(sorted, [](const Entry* a, const Entry* b) { return a->totalNs > b->totalNs; });
+      std::string out;
+      char buf[200];
+      for (size_t i = 0; i < sorted.size() && i < top; i++)
+      {
+         const Entry& e = *sorted[i];
+         snprintf(buf, sizeof(buf), "%s%s@%u %.1f/f x%.0f %.2fms", i == 0 ? "" : " | ", e.name, (unsigned)e.line, double(e.totalNs) * 1e-6 / frames,
+            double(e.count) / frames, double(e.totalNs) * 1e-6 / std::max<uint64_t>(e.count, 1));
+         out += buf;
+      }
+      return out;
+   }
+
+private:
+   struct Entry
+   {
+      const char* name = nullptr;
+      uint16_t line = 0;
+      uint32_t count = 0;
+      uint64_t totalNs = 0;
+   };
+   struct Frame
+   {
+      int entry;
+      uint64_t start;
+   };
+
+   static constexpr int kMaxEntries = 512;
+   static constexpr int kMaxDepth = 64;
+
+   static uint64_t Now() { return (uint64_t)std::chrono::duration_cast<std::chrono::nanoseconds>(std::chrono::steady_clock::now().time_since_epoch()).count(); }
+
+   void ClearTable()
+   {
+      for (int i = 0; i < m_numEntries; i++)
+      {
+         m_entries[i].count = 0;
+         m_entries[i].totalNs = 0;
+      }
+   }
+
+   int Find(const char* name, uint16_t line)
+   {
+      // scope names are string literals: compare the pointer first, the table is small
+      for (int i = 0; i < m_numEntries; i++)
+         if (m_entries[i].line == line && (m_entries[i].name == name))
+            return i;
+      if (m_numEntries >= kMaxEntries)
+         return -1;
+      m_entries[m_numEntries] = { name, line, 0, 0 };
+      return m_numEntries++;
+   }
+
+   Entry m_entries[kMaxEntries];
+   volatile int m_numEntries = 0;
+   Frame m_stack[kMaxDepth];
+   int m_depth = 0;
+   std::atomic<bool> m_reset { false };
+};
