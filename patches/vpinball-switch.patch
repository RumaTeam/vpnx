+// ---- formatting ----
+std::string FmtTime(long sec)
+{
+   if (sec < 60)
+      return sec <= 0 ? "-" : "<1m";
+   const long h = sec / 3600, m = (sec % 3600) / 60;
+   char buf[32];
+   if (h > 0)
+      snprintf(buf, sizeof buf, "%ldh %02ldm", h, m);
+   else
+      snprintf(buf, sizeof buf, "%ldm", m);
+   return buf;
+}
+
+std::string FmtLast(long epoch)
+{
+   if (epoch <= 0)
+      return "-";
+   const long days = static_cast<long>(time(nullptr) / 86400) - epoch / 86400;
+   if (days <= 0)
+      return Tr("today");
+   if (days == 1)
+      return Tr("yesterday");
+   char buf[32];
+   snprintf(buf, sizeof buf, Tr("%ld days").c_str(), days);
+   return buf;
+}
