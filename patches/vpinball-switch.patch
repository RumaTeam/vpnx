+char Letter(const Table& t)
+{
+   const unsigned char c = t.name.empty() ? '#' : static_cast<unsigned char>(t.name[0]);
+   return isalpha(c) ? static_cast<char>(toupper(c)) : '#';
+}
+
+std::string Lower(std::string s)
+{
+   std::transform(s.begin(), s.end(), s.begin(), [](unsigned char c) { return static_cast<char>(tolower(c)); });
+   return s;
+}
+
+void LoadTables()
+{
+   g_tables.clear();
+   IndexMedia();
+   for (const char* dir : { "/roms/vpx", "/roms/pinball", "/switch/vpnx" })
+      ScanTables(dir, 1, g_tables);
+   std::sort(g_tables.begin(), g_tables.end(), [](const Table& a, const Table& b) { return a.path < b.path; });
+   g_tables.erase(std::unique(g_tables.begin(), g_tables.end(), [](const Table& a, const Table& b) { return a.path == b.path; }), g_tables.end());
+   std::sort(g_tables.begin(), g_tables.end(), [](const Table& a, const Table& b) { return Lower(a.name) < Lower(b.name); });
+   FrontendLog("-- " + std::to_string(g_tables.size()) + " tables, " + std::to_string(g_media.size()) + " images in media/");
+   for (const auto& t : g_tables)
+      FrontendLog("   " + t.name + " -> " + (t.shot.empty() ? std::string("(no image)") : t.shot));
+   const nlohmann::json state = LoadState();
+   if (state.contains("view"))
+      g_gridView = state.value("view", "list") == "grid";
+   g_lastChosen = state.value("last", std::string());
+   g_opts.clear();
+   if (state.contains("options") && state["options"].is_object())
+      for (auto it = state["options"].begin(); it != state["options"].end(); ++it)
+         if (it.value().is_string())
+            g_opts[it.key()] = it.value().get<std::string>();
+   g_pt = g_opts.count("lang") && g_opts["lang"] == "pt";
+   if (state.contains("tables") && state["tables"].is_object())
+      for (auto& t : g_tables)
+         if (state["tables"].contains(t.path)) {
+            const auto& e = state["tables"][t.path];
+            t.fav = e.value("fav", false);
+            t.playSec = e.value("sec", 0L);
+            t.last = e.value("last", 0L);
+         }
+}
+
+void SaveTables()
+{
+   nlohmann::json state = LoadState();
+   state["view"] = g_gridView ? "grid" : "list";
+   state["last"] = g_lastChosen;
+   for (const auto& o : g_opts)
+      state["options"][o.first] = o.second;
+   for (const auto& t : g_tables) {
+      auto& e = state["tables"][t.path];
+      e["fav"] = t.fav;
+      e["sec"] = t.playSec;
+      e["last"] = t.last;
+   }
+   SaveState(state);
+}
+
+void Rebuild()
+{
+   g_vis.clear();
+   for (size_t i = 0; i < g_tables.size(); i++)
+      if (!g_onlyFav || g_tables[i].fav)
+         g_vis.push_back(static_cast<int>(i));
+}
