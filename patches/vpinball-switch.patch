+// the NRO the forwarder opens: where this one runs from, if it is a real file (not the netloader's temporary copy), else the usual places
+bool ForwarderTarget(const std::string& self, std::string& out)
+{
+   for (const std::string& c : { self, std::string("/switch/vpnx/vpnx.nro"), std::string("/switch/vpnx.nro") }) {
+      if (c.empty() || c.find("netloader") != std::string::npos || c.find("nxlink") != std::string::npos)
+         continue;
+      const std::string plain = c.compare(0, 5, "sdmc:") == 0 ? c.substr(5) : c;
+      if (!FileExists(plain))
+         continue;
+      out = "sdmc:" + plain;
+      return true;
+   }
+   return false;
+}
