+// license:GPLv3+
+// Copyright (c) 2026 RumaTeam
+// The VPNX table browser used when the app is started without Ruma: a list / grid of the .vpx tables with their screenshot.
+// Drawn in software straight into the libnx framebuffer (no GL, no SDL video): the player's Vulkan stack cannot share the
+// process with Mesa's GL, and the framebuffer is released before the player takes the window.
+#pragma once
+
+#include <map>
+#include <string>
+
+// Shows the browser (after the splash on a cold start) until a table is chosen (returns its path) or the user quits (returns an empty string).
+std::string FrontendRun(bool splash, const std::string& selfNro);
+
+// Adds the time played to the table's statistics (sdmc:/switch/vpnx/fe.json).
+void FrontendRecordPlay(const std::string& table, long seconds);
+
+// The player options chosen in the browser (ids as in docs/ruma/options.json: view, dmd, clock), from sdmc:/switch/vpnx/fe.json.
+std::map<std::string, std::string> FrontendOptions();
+
+// The text in the language chosen in the options (the English text is the key; Portuguese is its translation). For forwarder.cpp.
+const char* FrontendTr(const char* english);
diff --git a/switch/main.cpp b/switch/main.cpp
new file mode 100644
index 0000000..dcb0ba2
--- /dev/null
+++ b/switch/main.cpp
@@ -0,0 +1,766 @@
+// license:GPLv3+
+// Copyright (c) 2026 RumaTeam
+// Nintendo Switch (libnx) shell for libvpinball: the platform layer that iOS/Android provide in
+// Swift/Kotlin. It initialises the library, loads a table from the SD card and plays it.
+//
+//   nxlink --args "<path to .vpx>"   (default: first .vpx found in /switch/vpnx)
+#include <cmath>
+#include <cstdio>
+#include <cstdlib>
+#include <cstring>
+#include <ctime>
+#include <dirent.h>
+#include <exception>
+#include <typeinfo>
+#include <unwind.h>
+#include <pthread.h>
+#include <algorithm>
+#include <map>
+#include <vector>
+#include <string>
+#include <unistd.h>
+
+#include <switch.h>
+#include <nlohmann/json.hpp>
+#include <SDL3/SDL.h>
+#include <SDL3/SDL_main.h>
+
+#include "VPinballLib_C.h"
+#include "frontend.h"
+
+static FILE* g_logFile = nullptr; // also logged to the SD card so a crash can be diagnosed without nxlink
+#define LOG(...) do { \
+   fprintf(stderr, __VA_ARGS__); fflush(stderr); \
+   if (g_logFile) { fprintf(g_logFile, __VA_ARGS__); fflush(g_logFile); fsync(fileno(g_logFile)); } \
+} while (0)
+
+// entry points defined in lib/src/VPinballLib_C.cpp (SDL app-callback API, driven by hand here)
+SDL_AppResult SDL_AppInit(void **appstate, int argc, char **argv);
+SDL_AppResult SDL_AppIterate(void *appstate);
+SDL_AppResult SDL_AppEvent(void *appstate, SDL_Event *event);
+
+// --- crash reporting: libnx routes faults on the main thread here; the dump is written to the SD card ---
+static const char* kDumpPath = "/switch/vpnx/exception_dump.txt";
+__attribute__((used, noinline)) void CrashAnchor() {} // lets runtime pcs be turned into ELF addresses (NRO base is randomised)
+
+alignas(16) u8 __nx_exception_stack[0x4000];
+u64 __nx_exception_stack_size = sizeof(__nx_exception_stack);
+
+extern "C" void __libnx_exception_handler(ThreadExceptionDump* ctx)
+{
+   FILE* f = fopen(kDumpPath, "w");
+   if (!f)
+      return;
+   fprintf(f, "anchor_rt: 0x%lx\nerror_desc: 0x%x\n", (unsigned long)&CrashAnchor, ctx->error_desc);
+   fprintf(f, "pc: 0x%lx\nlr: 0x%lx\nsp: 0x%lx\nfp: 0x%lx\nfar: 0x%lx\nesr: 0x%x\n", (unsigned long)ctx->pc.x,
+      (unsigned long)ctx->lr.x, (unsigned long)ctx->sp.x, (unsigned long)ctx->fp.x, (unsigned long)ctx->far.x, ctx->esr);
+   fclose(f);
+}
+
+// Ring of the last C++ throws (return address + type), filled by the --wrap=__cxa_throw link option, so that a
+// terminate can name the throw site (the terminate handler itself only sees the abort path).
+static void* g_throwSite[16];
+static void* g_throwFrames[16][10]; // call chain of each throw (frame 0 = inside the thrower)
+static const char* g_throwType[16];
+static volatile unsigned g_throwCount = 0;
+struct BacktraceState { void** out; int n; };
+static _Unwind_Reason_Code BacktraceCb(_Unwind_Context* ctx, void* arg)
+{
+   auto* st = static_cast<BacktraceState*>(arg);
+   if (st->n >= 10)
+      return _URC_END_OF_STACK;
+   st->out[st->n++] = reinterpret_cast<void*>(_Unwind_GetIP(ctx));
+   return _URC_NO_REASON;
+}
+extern "C" __attribute__((noreturn)) void __real___cxa_throw(void*, void*, void (*)(void*));
+extern "C" __attribute__((noreturn)) void __wrap___cxa_throw(void* obj, void* tinfo, void (*dest)(void*))
+{
+   const unsigned i = __atomic_fetch_add(&g_throwCount, 1u, __ATOMIC_RELAXED) % 16u;
+   g_throwSite[i] = __builtin_return_address(0);
+   g_throwType[i] = static_cast<const std::type_info*>(tinfo)->name();
+   for (void*& f : g_throwFrames[i]) f = nullptr;
+   BacktraceState st{ g_throwFrames[i], 0 };
+   _Unwind_Backtrace(BacktraceCb, &st);
+   __real___cxa_throw(obj, tinfo, dest);
+}
+
+// libnx gives pthreads a 1 MiB stack by default, which Mesa's GLSL compiler (run on the render thread when bgfx builds
+// the table's shaders) overflows (_mesa_glsl_parse, fault address == sp). Every thread gets a bigger stack instead;
+// hooked with the --wrap=pthread_create link option.
+extern "C" int __real_pthread_create(pthread_t*, const pthread_attr_t*, void* (*)(void*), void*);
+extern "C" int __wrap_pthread_create(pthread_t* thread, const pthread_attr_t* attr, void* (*fn)(void*), void* arg)
+{
+   static const size_t kMinStack = 8u << 20;
+   pthread_attr_t a;
+   if (attr)
+      a = *attr;
+   else
+      pthread_attr_init(&a);
+   size_t cur = 0;
+   if (pthread_attr_getstacksize(&a, &cur) != 0 || cur < kMinStack)
+      pthread_attr_setstacksize(&a, kMinStack);
+   return __real_pthread_create(thread, &a, fn, arg);
+}
+
+// uncaught C++ exceptions (any thread) end in terminate -> svcBreak, which bypasses the handler above: record what() first
+static void TerminateHandler()
+{
+   FILE* f = fopen("/switch/vpnx/terminate.txt", "w");
+   if (f) {
+      try {
+         if (const auto ep = std::current_exception())
+            std::rethrow_exception(ep);
+         fprintf(f, "terminate called without an active exception\n");
+      } catch (const std::exception& e) {
+         fprintf(f, "uncaught std::exception: %s\n", e.what());
+      } catch (...) {
+         fprintf(f, "uncaught non-std exception\n");
+      }
+      fprintf(f, "anchor_rt: 0x%lx lr: 0x%lx\n", (unsigned long)&CrashAnchor, (unsigned long)__builtin_return_address(0));
+      const unsigned n = g_throwCount;
+      for (unsigned k = 0; k < 16 && k < n; k++) { // newest first
+         const unsigned i = (n - 1 - k) % 16u;
+         fprintf(f, "throw[%u]: site 0x%lx type %s\n", k, (unsigned long)g_throwSite[i], g_throwType[i]);
+         for (int fr = 0; fr < 10 && g_throwFrames[i][fr]; fr++)
+            fprintf(f, "   frame %d: 0x%lx\n", fr, (unsigned long)g_throwFrames[i][fr]);
+      }
+      fclose(f);
+   }
+   abort();
+}
+
+// runs before every other static constructor: tells a crash in static init from one in main()
+__attribute__((constructor(101))) static void EarlyMarker()
+{
+   if (FILE* f = fopen("/switch/vpnx/early.log", "w")) {
+      fprintf(f, "first static constructor reached\n");
+      fclose(f);
+   }
+}
+
+// If tearing the player down hangs (it did, after pressing +), leave the process after a few seconds so the user is
+// returned to the launcher instead of facing a frozen screen. Runs on a libnx thread of its own.
+static volatile bool g_watchdogStop = false;
+static bool g_watchdogStarted = false;
+static Thread g_watchdog;
+
+static void WatchdogThread(void*)
+{
+   while (!g_watchdogStop) {
+      svcSleepThread(100000000ll);
+      if (VPinballClosingForMs() > 6000) {
+         LOG("[watchdog] player teardown stuck for %u ms: exiting the process\n", VPinballClosingForMs());
+         svcExitProcess();
+      }
+   }
+}
+
+// ---- Ruma (https://github.com/RumaTeam/ruma, the RumaTeam emulation frontend) -----------------------------------------------
+// Ruma lists the tables, writes /ruma/session.json and launches this NRO as a runner: "{nro} --rom {rom} --session {session}".
+// The session carries the table (rom), the resolved options and where to go back (return.nro / return.argv). When this app ends it
+// hands control back with envSetNextLoad. Ruma consumes (reads, then deletes) the session itself: it must not be touched here.
+// Not linked with libruma-runner (SDL2; this app is SDL3), so the small part of the protocol that matters is done here.
+struct RumaSession
+{
+   bool active = false;
+   std::string rom;
+   std::string returnNro, returnArgv;
+   std::map<std::string, std::string> options;
+};
+static RumaSession g_ruma;
+
+static std::string JsonScalarToString(const nlohmann::json& v)
+{
+   if (v.is_string())
+      return v.get<std::string>();
+   if (v.is_boolean())
+      return v.get<bool>() ? "true" : "false";
+   return v.dump();
+}
+
+static void LoadRumaSession(const char* path)
+{
+   FILE* f = fopen(path, "rb");
+   if (!f) {
+      LOG("[ruma] cannot open the session %s\n", path);
+      return;
+   }
+   std::string text;
+   char buf[4096];
+   size_t n;
+   while ((n = fread(buf, 1, sizeof buf, f)) > 0)
+      text.append(buf, n);
+   fclose(f);
+   try {
+      const nlohmann::json j = nlohmann::json::parse(text);
+      g_ruma.rom = j.value("rom", std::string());
+      if (j.contains("options") && j["options"].is_object())
+         for (const auto& [k, v] : j["options"].items())
+            g_ruma.options[k] = JsonScalarToString(v);
+      if (j.contains("return") && j["return"].is_object()) {
+         g_ruma.returnNro = j["return"].value("nro", std::string());
+         g_ruma.returnArgv = j["return"].value("argv", std::string());
+      }
+      g_ruma.active = !g_ruma.rom.empty();
+      LOG("[ruma] session: rom=%s, %zu options, return=%s\n", g_ruma.rom.c_str(), g_ruma.options.size(), g_ruma.returnNro.c_str());
+   } catch (const std::exception& e) {
+      LOG("[ruma] bad session file: %s\n", e.what());
+   }
+}
+
+static std::string RumaOption(const char* id, const char* fallback = "")
+{
+   const auto it = g_ruma.options.find(id);
+   return it != g_ruma.options.end() ? it->second : std::string(fallback);
+}
