+// returns true when the user chose to go on in applet mode, false when the app should close
+bool RunAppletGate(Framebuffer* fb, PadState* pad, const std::string& selfNro)
+{
+   const std::vector<std::string> ask = {
+      Tr("For better performance VPNX needs to run in Application mode (with all of the console's memory)."),
+      Tr("Would you like to create a forwarder for that? It adds the VPNX icon to the game list on the HOME menu and always opens in Application mode."),
+      Tr("If you prefer not to, VPNX will close. Run it manually in Application mode: hold R while opening a game and launch VPNX from the hbmenu. Y continues anyway, at the risk of running out of memory on big tables.")
+   };
+   enum { Ask, Work, Done } state = Ask;
+   int focus = 0; // 0 = Sim, 1 = Não
+   std::string msg;
+   std::vector<std::string> doneParas;
+   while (appletMainLoop()) {
+      padUpdate(pad);
+      const u64 d = padGetButtonsDown(pad);
+      if (state == Ask) {
+         if (d & (HidNpadButton_Left | HidNpadButton_Right | HidNpadButton_StickLLeft | HidNpadButton_StickLRight))
+            focus ^= 1;
+         DrawGate(focus, ask, Tr("Yes").c_str(), Tr("No").c_str(), Tr("D-pad Choose  ·  A Confirm  ·  B No  ·  Y Continue").c_str());
+         Present(fb);
+         if (d & HidNpadButton_Y)
+            return true;
+         if (d & HidNpadButton_B)
+            return false;
+         if (d & HidNpadButton_A) {
+            if (focus == 1)
+               return false;
+            state = Work;
+         }
+      } else if (state == Work) {
+         DrawGate(0, { Tr("Creating the forwarder... (do not close VPNX or turn off the console)") }, nullptr, nullptr, nullptr);
+         Present(fb);
+         std::string target;
+         char err[400] = "";
+         romfsInit();
+         if (!ForwarderTarget(selfNro, target))
+            msg = Tr("Could not find vpnx.nro. Install VPNX at sd:/switch/vpnx/vpnx.nro and open it from there. Then open it manually in Application mode.");
+         else if (forwarder_create(target.c_str(), err, sizeof err))
+            msg = Tr("Forwarder created. VPNX will close: open it from the icon in the HOME menu game list (it always opens in Application mode).");
+         else
+            msg = std::string(err) + Tr(" Open VPNX manually in Application mode.");
+         romfsExit();
+         doneParas = { msg };
+         state = Done;
+      } else {
+         DrawGate(0, doneParas, Tr("Close").c_str(), nullptr, nullptr);
+         Present(fb);
+         if (d & (HidNpadButton_A | HidNpadButton_B | HidNpadButton_Plus))
+            return false;
+      }
+   }
+   return false;
+}
+
+struct Repeat
+{
+   uint64_t since = 0, last = 0;
+};
+
+bool Rep(Repeat& r, bool held)
+{
+   if (!held) {
+      r.since = 0;
+      return false;
+   }
+   const uint64_t now = armTicksToNs(armGetSystemTick()) / 1000000ull;
+   if (r.since == 0) {
+      r.since = r.last = now;
+      return true;
+   }
+   if (now - r.since > 320 && now - r.last >= 70) {
+      r.last = now;
+      return true;
+   }
+   return false;
+}
+
+} // namespace
+
+void FrontendRecordPlay(const std::string& table, long seconds)
+{
+   if (table.empty() || seconds <= 0)
+      return;
+   nlohmann::json state = LoadState();
+   auto& e = state["tables"][table];
+   e["sec"] = e.value("sec", 0L) + seconds;
+   e["last"] = static_cast<long>(time(nullptr));
+   SaveState(state);
+}
+
+const char* FrontendTr(const char* english)
+{
+   static std::string shown; // forwarder.cpp keeps the pointer only until the next call
+   shown = Tr(english);
+   return shown.c_str();
+}
+
+std::map<std::string, std::string> FrontendOptions()
+{
+   std::map<std::string, std::string> out;
+   const nlohmann::json state = LoadState();
+   if (state.contains("options") && state["options"].is_object())
+      for (auto it = state["options"].begin(); it != state["options"].end(); ++it)
+         if (it.value().is_string())
+            out[it.key()] = it.value().get<std::string>();
+   return out;
+}
+
+std::string FrontendRun(bool splash, const std::string& selfNro)
+{
+   {
+      // the language is known from the start: the applet-mode notice shows before the tables are loaded
+      const nlohmann::json state = LoadState();
+      g_pt = state.contains("options") && state["options"].is_object() && state["options"].value("lang", std::string()) == "pt";
+   }
+   plInitialize(PlServiceType_User);
+   PlFontData fd;
+   if (R_SUCCEEDED(plGetSharedFontByType(&fd, PlSharedFontType_Standard))) {
+      g_fontData = fd.address;
+      g_fontSize = fd.size;
+   }
+   TTF_Init();
+   psmInitialize();
+   g_canvas = SDL_CreateSurface(kW, kH, SDL_PIXELFORMAT_RGBA32);
+   Framebuffer fb;
+   framebufferCreate(&fb, nwindowGetDefault(), kW, kH, PIXEL_FORMAT_RGBA_8888, 2);
+   framebufferMakeLinear(&fb);
+
+   padConfigureInput(1, HidNpadStyleSet_NpadStandard);
+   PadState pad;
+   padInitializeDefault(&pad);
+
+   if (splash) {
+      const uint64_t t0 = armTicksToNs(armGetSystemTick()) / 1000000ull;
+      while (appletMainLoop()) {
+         padUpdate(&pad);
+         const int t = static_cast<int>(armTicksToNs(armGetSystemTick()) / 1000000ull - t0);
+         DrawSplash(t);
+         Present(&fb);
+         if (t >= kSplashMs || (t > 300 && padGetButtonsDown(&pad)))
+            break;
+      }
+   }
+   // a cold start in applet mode (hbmenu opened from the album): the memory is not enough for the big tables
+   bool closeNow = false;
+   if (splash && appletGetAppletType() != AppletType_Application)
+      closeNow = !RunAppletGate(&fb, &pad, selfNro);
+
+   LoadTables();
+   Rebuild();
+   int sel = 0;
+   for (size_t i = 0; i < g_vis.size(); i++)
+      if (g_tables[g_vis[i]].path == g_lastChosen)
+         sel = static_cast<int>(i);
+   int top = 0;
+   bool inOptions = false;
+   bool inHelp = false;
+   int optSel = 0;
+   std::string chosen;
+   std::string toast;
+   uint64_t toastUntil = 0;
+   bool dirty = true;
+   uint64_t lastPresent = 0;
+   Repeat rUp, rDown, rLeft, rRight, rZL, rZR, rL, rR;
+   const bool playerOk = true;
+
+   while (!closeNow && appletMainLoop()) {
+      padUpdate(&pad);
+      u64 down = padGetButtonsDown(&pad), held = padGetButtons(&pad);
+      const int n = static_cast<int>(g_vis.size());
+      const int perPage = g_gridView ? kCols * kGridRows : kRows;
+      int moved = 0;
+      const int optRows = static_cast<int>(kOpts.size()) + 1; // the options and, last, the controls help
+      if (inHelp) {
+         if (down & (HidNpadButton_B | HidNpadButton_A | HidNpadButton_Plus)) {
+            inHelp = false;
+            dirty = true;
+         }
+         down = 0;
+         held = 0;
+      } else if (inOptions) {
+         if (down & (HidNpadButton_Down | HidNpadButton_StickLDown)) {
+            optSel = (optSel + 1) % optRows;
+            dirty = true;
+         }
+         if (down & (HidNpadButton_Up | HidNpadButton_StickLUp)) {
+            optSel = (optSel + optRows - 1) % optRows;
+            dirty = true;
+         }
+         if (down & (HidNpadButton_Right | HidNpadButton_A)) {
+            if (optSel == static_cast<int>(kOpts.size()))
+               inHelp = true;
+            else
+               CycleOpt(kOpts[optSel], 1);
+            dirty = true;
+         }
+         if ((down & HidNpadButton_Left) && optSel < static_cast<int>(kOpts.size())) {
+            CycleOpt(kOpts[optSel], -1);
+            dirty = true;
+         }
+         if (down & (HidNpadButton_B | HidNpadButton_Plus)) {
+            inOptions = false;
+            SaveTables();
+            dirty = true;
+         }
+         // what was pressed here belongs to this screen: the browser's own handling below must not see it (B would quit, + reopen)
+         down = 0;
+         held = 0;
+      } else if (g_gridView) {
+         if (Rep(rUp, held & (HidNpadButton_Up | HidNpadButton_StickLUp)))
+            moved -= kCols;
+         if (Rep(rDown, held & (HidNpadButton_Down | HidNpadButton_StickLDown)))
+            moved += kCols;
+         if (Rep(rLeft, held & (HidNpadButton_Left | HidNpadButton_StickLLeft)))
+            moved -= 1;
+         if (Rep(rRight, held & (HidNpadButton_Right | HidNpadButton_StickLRight)))
+            moved += 1;
+      } else {
+         if (Rep(rUp, held & (HidNpadButton_Up | HidNpadButton_StickLUp)))
+            moved -= 1;
+         if (Rep(rDown, held & (HidNpadButton_Down | HidNpadButton_StickLDown)))
+            moved += 1;
+      }
+      if (!inOptions && Rep(rZL, held & HidNpadButton_ZL))
+         moved -= perPage;
+      if (!inOptions && Rep(rZR, held & HidNpadButton_ZR))
+         moved += perPage;
+      if (n > 0 && moved != 0) {
+         sel = std::clamp(sel + moved, 0, n - 1);
+         dirty = true;
+      }
+      // letters: L / R jump to the previous / next initial
+      if (!inOptions && n > 0 && (Rep(rL, held & HidNpadButton_L) || Rep(rR, held & HidNpadButton_R))) {
+         const bool forward = (held & HidNpadButton_R) != 0;
+         const char cur = Letter(g_tables[g_vis[sel]]);
+         int i = sel;
+         if (forward) {
+            while (i < n - 1 && Letter(g_tables[g_vis[i]]) == cur)
+               i++;
+         } else {
+            while (i > 0 && Letter(g_tables[g_vis[i]]) == cur)
+               i--;
+            const char target = Letter(g_tables[g_vis[i]]);
+            while (i > 0 && Letter(g_tables[g_vis[i - 1]]) == target)
+               i--;
+         }
+         sel = i;
+         dirty = true;
+      }
+      if (!inOptions && (down & HidNpadButton_Y)) {
+         g_gridView = !g_gridView;
+         SaveTables();
+         dirty = true;
+      }
+      if (!inOptions && (down & HidNpadButton_X) && n > 0) {
+         Table& t = g_tables[g_vis[sel]];
+         t.fav = !t.fav;
+         SaveTables();
+         if (g_onlyFav && !t.fav) {
+            Rebuild();
+            sel = std::min(sel, std::max(0, static_cast<int>(g_vis.size()) - 1));
+         }
+         dirty = true;
+      }
+      if (!inOptions && (down & HidNpadButton_Minus)) {
+         const std::string keep = n > 0 ? g_tables[g_vis[sel]].path : std::string();
+         g_onlyFav = !g_onlyFav;
+         Rebuild();
+         sel = 0;
+         for (size_t i = 0; i < g_vis.size(); i++)
+            if (g_tables[g_vis[i]].path == keep)
+               sel = static_cast<int>(i);
+         dirty = true;
+      }
+      if (!inOptions && (down & HidNpadButton_A) && n > 0) {
+         chosen = g_tables[g_vis[sel]].path;
+         g_lastChosen = chosen;
+         SaveTables();
+         break;
+      }
+      if (!inOptions && (down & HidNpadButton_Plus)) {
+         inOptions = true;
+         dirty = true;
+      }
+      if (!inOptions && (down & HidNpadButton_B))
+         break;
+
+      // keep the selection in view
+      if (g_gridView) {
+         int row = n > 0 ? sel / kCols : 0;
+         const int maxTop = std::max(0, (n + kCols - 1) / kCols - kGridRows);
+         if (row < top)
+            top = row;
+         if (row >= top + kGridRows)
+            top = row - kGridRows + 1;
+         top = std::clamp(top, 0, maxTop);
+      } else {
+         if (sel < top)
+            top = sel;
+         if (sel >= top + kRows)
+            top = sel - kRows + 1;
+         top = std::clamp(top, 0, std::max(0, n - kRows));
+      }
+
+      const uint64_t nowMs = armTicksToNs(armGetSystemTick()) / 1000000ull;
+      if (nowMs - lastPresent > 1000)
+         dirty = true;
+      if (dirty) {
+         lastPresent = nowMs;
+         u32 battery = 0;
+         psmGetBatteryChargePercentage(&battery);
+         const bool docked = appletGetOperationMode() == AppletOperationMode_Console;
+         Fill(0, 0, kW, kH, cBg);
+         size_t favs = 0;
+         for (const auto& t : g_tables)
+            favs += t.fav ? 1 : 0;
+         if (inHelp) {
+            DrawHelp();
+         } else if (inOptions) {
+            DrawOptions(optSel);
+         } else if (g_tables.empty()) {
+            Text(kW / 2, 300, 24, Tr("No tables found"), 20, cHi, true, 2);
+            Text(kW / 2, 336, 20, Tr("Put .vpx files in /roms/vpx, /roms/pinball or /switch/vpnx"), 13, cMid, false, 2);
+         } else if (g_vis.empty()) {
+            TitleBar(Tr("Tables"), 0, favs);
+            Text(kW / 2, 300, 24, Tr("No tables with this filter"), 18, cMid, false, 2);
+         } else if (g_gridView) {
+            DrawGrid(sel, top, favs);
+         } else {
+            DrawList(sel, top, favs, playerOk);
+         }
+         Header(g_tables.size(), docked ? std::string("DOCK · 1080p") : Tr("HANDHELD · 720p"), battery);
+         char pos[48];
+         snprintf(pos, sizeof pos, "%d / %d", g_vis.empty() ? 0 : sel + 1, n);
+         if (inHelp)
+            Footer("", { { "B", Tr("Back") } });
+         else if (inOptions)
+            Footer("", { { "B", Tr("Back") }, { "A", Tr("Change") } });
+         else
+            Footer(pos, { { "-", Tr(g_onlyFav ? "All" : "Favorites") }, { "L R", Tr("Letter") }, { "ZL ZR", Tr("Page") }, { "Y", Tr(g_gridView ? "List" : "Grid") },
+                            { "X", Tr("Toggle favorite") }, { "+", Tr("Options") }, { "B", Tr("Quit") }, { "A", Tr("Play") } });
+         if (!toast.empty() && nowMs < toastUntil)
+            Text(kW / 2, 640, 24, toast, 14, cWarn, true, 2);
+         u32 stride = 0;
+         uint8_t* buf = static_cast<uint8_t*>(framebufferBegin(&fb, &stride));
+         for (int y = 0; y < kH; y++)
+            memcpy(buf + static_cast<size_t>(y) * stride, static_cast<uint8_t*>(g_canvas->pixels) + static_cast<size_t>(y) * g_canvas->pitch, kW * 4);
+         framebufferEnd(&fb);
+         // a screenshot still loading (one per frame): draw again until all are in
+         dirty = false;
+         for (int k = 0; k < static_cast<int>(g_vis.size()); k++) {
+            const int visIdx = g_gridView ? top * kCols + k : sel;
+            if (g_gridView ? k >= kCols * kGridRows : k > 0)
+               break;
+            if (visIdx >= static_cast<int>(g_vis.size()))
+               break;
+            const Table& t = g_tables[g_vis[visIdx]];
+            const int w = g_gridView ? kCardW : 392, h = g_gridView ? kCardH : 220;
+            if (!t.shot.empty() && g_shots.find(t.shot + "@" + std::to_string(w) + "x" + std::to_string(h)) == g_shots.end())
+               dirty = true;
+         }
+      } else {
+         svcSleepThread(8000000ll);
+      }
+   }
+
+   framebufferClose(&fb);
+   for (auto& e : g_textCache)
+      if (e.second.surf)
+         SDL_DestroySurface(e.second.surf);
+   g_textCache.clear();
+   for (auto& e : g_shots)
+      if (e.second.surf)
+         SDL_DestroySurface(e.second.surf);
+   g_shots.clear();
+   SDL_DestroySurface(g_canvas);
+   g_canvas = nullptr;
+   TTF_Quit();
+   psmExit();
+   plExit();
+   return chosen;
+}
