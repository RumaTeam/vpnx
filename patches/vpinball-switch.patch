+struct Shot
+{
+   SDL_Surface* surf = nullptr;
+   bool failed = false;
+   unsigned long used = 0;
+};
+std::unordered_map<std::string, Shot> g_shots;
+std::map<std::string, std::string> g_shotErrors; // image path -> why it could not be read
+unsigned long g_tick = 0;
+int g_loadBudget = 0;
+
+// the screenshot scaled to w x h, cropped to cover; nullptr while it is not loaded (one load per frame) or when missing
+SDL_Surface* ShotSurface(const std::string& path, int w, int h)
+{
+   if (path.empty())
+      return nullptr;
+   const std::string key = path + "@" + std::to_string(w) + "x" + std::to_string(h);
+   auto it = g_shots.find(key);
+   if (it != g_shots.end()) {
+      it->second.used = ++g_tick;
+      return it->second.surf;
+   }
+   if (g_loadBudget <= 0)
+      return nullptr;
+   g_loadBudget--;
+   Shot shot;
+   shot.used = ++g_tick;
+   SDL_Surface* src = IMG_Load(path.c_str());
+   if (!src) {
+      g_shotErrors[path] = SDL_GetError();
+      FrontendLog("   cannot read " + path + ": " + g_shotErrors[path]);
+   }
+   if (src) {
+      SDL_Surface* dst = SDL_CreateSurface(w, h, SDL_PIXELFORMAT_RGBA32);
+      if (dst) {
+         // crop the source to the target's aspect ("cover")
+         SDL_Rect crop = { 0, 0, src->w, src->h };
+         if (src->w * h > src->h * w) {
+            crop.w = src->h * w / h;
+            crop.x = (src->w - crop.w) / 2;
+         } else {
+            crop.h = src->w * h / w;
+            crop.y = (src->h - crop.h) / 2;
+         }
+         SDL_SetSurfaceBlendMode(src, SDL_BLENDMODE_NONE);
+         SDL_BlitSurfaceScaled(src, &crop, dst, nullptr, SDL_SCALEMODE_LINEAR);
+         shot.surf = dst;
+      }
+      SDL_DestroySurface(src);
+   }
+   shot.failed = shot.surf == nullptr;
+   if (shot.failed && !g_shotErrors.count(path))
+      g_shotErrors[path] = "the image could not be scaled";
+   if (g_shots.size() > 40) {
+      auto oldest = g_shots.begin();
+      for (auto i = g_shots.begin(); i != g_shots.end(); ++i)
+         if (i->second.used < oldest->second.used)
+            oldest = i;
+      if (oldest->second.surf)
+         SDL_DestroySurface(oldest->second.surf);
+      g_shots.erase(oldest);
+   }
+   g_shots[key] = shot;
+   return shot.surf;
+}
