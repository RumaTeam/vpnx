+// time the player teardown started (0 when not tearing down); read by the console shell's watchdog thread
+unsigned int VPinballLib::ClosingForMs() const
+{
+   const Uint64 since = s_closingSince;
+   return since == 0 ? 0u : static_cast<unsigned int>(SDL_GetTicks() - since);
+}
+
+string VPinballLib::GetPerfSummary(bool reset)
+{
+   if (g_pplayer == nullptr || g_pplayer->m_renderProfiler == nullptr)
+      return {};
+   // Times are microseconds per frame: logic thread (game state: physics, script, frame preparation) and render thread
+   // (submit to the GPU driver, flip, waiting on the swap chain). Both profilers are restarted so each report is a window.
+   using PS = FrameProfiler::ProfileSection;
+   FrameProfiler& lp = g_pplayer->m_logicProfiler;
+   FrameProfiler& rp = *g_pplayer->m_renderProfiler;
+   auto ms = [](double us) { return us * 1e-3; };
+   const double logicFrame = lp.GetAvg(PS::PROFILE_FRAME);
+   const double renderFrame = rp.GetAvg(PS::PROFILE_FRAME);
+   string out = std::format("logic {:.1f}fps frame {:.1f}ms (max {:.1f}) [physics {:.1f} script {:.1f} prepare {:.1f} sleep {:.1f}] | "
+                            "render {:.1f}fps frame {:.1f}ms (max {:.1f}) [wait-logic {:.1f} wait-swapchain {:.1f} submit {:.1f} flip {:.1f} sleep {:.1f}]",
+      logicFrame > 0. ? 1e6 / logicFrame : 0., ms(logicFrame), ms(lp.GetMax(PS::PROFILE_FRAME)), ms(lp.GetAvg(PS::PROFILE_PHYSICS)), ms(lp.GetAvg(PS::PROFILE_SCRIPT)),
+      ms(lp.GetAvg(PS::PROFILE_PREPARE_FRAME)), ms(lp.GetAvg(PS::PROFILE_SLEEP)),
+      renderFrame > 0. ? 1e6 / renderFrame : 0., ms(renderFrame), ms(rp.GetMax(PS::PROFILE_FRAME)), ms(rp.GetAvg(PS::PROFILE_RENDER_WAIT)),
+      ms(rp.GetAvg(PS::PROFILE_RENDER_WAIT_SC)), ms(rp.GetAvg(PS::PROFILE_RENDER_SUBMIT)), ms(rp.GetAvg(PS::PROFILE_RENDER_FLIP)), ms(rp.GetAvg(PS::PROFILE_RENDER_SLEEP)));
+   out += std::format(" | physics-steps/frame {} timers-in-list {} game-time {}ms real-time {}ms", g_pplayer->m_physics ? g_pplayer->m_physics->GetPerfNIterations() : 0u,
+      g_pplayer->GetActiveTimerCount(), g_pplayer->m_time_msec, static_cast<unsigned int>((usec() - g_pplayer->m_physics->GetStartTime()) / 1000));
+#ifdef ENABLE_BGFX
+   if (const bgfx::Stats* st = bgfx::getStats(); st != nullptr)
+   {
+      // per frame work submitted to the graphics driver: tells apart "too many draw calls" from "slow driver/GPU"
+      const double gpuMs = st->gpuTimerFreq != 0 && st->gpuTimeEnd > st->gpuTimeBegin ? 1e3 * double(st->gpuTimeEnd - st->gpuTimeBegin) / double(st->gpuTimerFreq) : -1.;
+      out += std::format(" | bgfx: draws {} blits {} tris {} programs {} textures {} fbos {} vbufs {} gpuMem {}MB texMem {}MB rtMem {}MB gpu {:.1f}ms cpu-frame {:.1f}ms",
+         st->numDraw, st->numBlit, st->numPrims[bgfx::Topology::TriList], st->numPrograms, st->numTextures, st->numFrameBuffers, st->numVertexBuffers,
+         static_cast<long long>(st->gpuMemoryUsed >> 20), static_cast<long long>(st->textureMemoryUsed >> 20), static_cast<long long>(st->rtMemoryUsed >> 20), gpuMs,
+         st->cpuTimerFreq != 0 ? 1e3 * double(st->cpuTimeEnd - st->cpuTimeBegin) / double(st->cpuTimerFreq) : -1.);
+   }
+#endif
+#ifdef ENABLE_BGFX
+   if (g_pplayer->m_renderer != nullptr && g_pplayer->m_renderer->m_renderDevice != nullptr)
+   {
+      // regions of the bgfx renderer, only present in a bgfx built with BGFX_PROFILER=1 (./build-bgfx.sh)
+      const string scopes = g_pplayer->m_renderer->m_renderDevice->GetBgfxScopeReport();
+      if (!scopes.empty())
+         out += "\n[scopes] " + scopes;
+      if (reset)
+         g_pplayer->m_renderer->m_renderDevice->ResetBgfxScopes();
+   }
+#endif
+   if (reset)
+   {
+      lp.Reset();
+      if (&lp != &rp)
+         rp.Reset();
+   }
+   return out;
+}
+
+void VPinballLib::LogWorstFrames()
+{
+   if (g_pplayer == nullptr)
+      return;
+   g_pplayer->m_logicProfiler.EnableWorstFrameLogging(true);
+   g_pplayer->m_logicProfiler.LogWorstFrame();
+}
