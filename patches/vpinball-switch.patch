+// ---- splash (like Ruma's): the mark lights tile by tile in reading order, then the word and the line below fade in ----
+constexpr const char kLogoShape[] = "10001" "10001" "10201" "01010" "01010" "00100";
+constexpr int kLightMs = 600, kFadeMs = 350, kSplashMs = 1500;
+
+void DrawSplash(int tMs)
+{
+   Fill(0, 0, kW, kH, cBg);
+   const int lit = tMs <= 0 ? 0 : (tMs >= kLightMs ? 30 : tMs * 30 / kLightMs);
+   const int tile = 16, gap = 4, markW = 5 * (tile + gap) - gap, markH = 6 * (tile + gap) - gap, space = 28;
+   const int wordW = TextWidth("VPNX", 64, true);
+   const int x = (kW - (markW + space + wordW)) / 2, y = (kH - markH) / 2 - 24;
+   for (int i = 0; i < 30; i++) {
+      const bool on = i < lit && kLogoShape[i] != '0';
+      FillRR(x + (i % 5) * (tile + gap), y + (i / 5) * (tile + gap), tile, tile, tile / 4, on ? (kLogoShape[i] == '2' ? cHi : cAccent) : 0x1F2733);
+   }
+   // the word and the line enter at the end (a few alpha steps: every colour is a text surface in the cache)
+   const int a = tMs <= kLightMs - kFadeMs ? 0 : (tMs >= kLightMs ? 255 : (tMs - (kLightMs - kFadeMs)) * 255 / kFadeMs);
+   const auto mix = [a](uint32_t rgb) {
+      const int steps = a / 64;
+      const int k = a >= 255 ? 4 : steps;
+      const int r = ((cBg >> 16) & 255) + static_cast<int>(((rgb >> 16) & 255) - ((cBg >> 16) & 255)) * k / 4;
+      const int g = ((cBg >> 8) & 255) + static_cast<int>(((rgb >> 8) & 255) - ((cBg >> 8) & 255)) * k / 4;
+      const int b = (cBg & 255) + static_cast<int>((rgb & 255) - (cBg & 255)) * k / 4;
+      return static_cast<uint32_t>((r << 16) | (g << 8) | b);
+   };
+   if (a > 0) {
+      Text(x + markW + space, y, markH, "VPNX", 64, mix(cHi), true);
+      Text(kW / 2, y + markH + 36, 24, Tr("Virtual Pinball anywhere"), 15, mix(cDim), false, 2);
+   }
+}
