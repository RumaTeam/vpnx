+// ---- canvas, text, images ----
+SDL_Surface* g_canvas = nullptr;
+std::string g_fontError;
+const void* g_fontData = nullptr;
+size_t g_fontSize = 0;
+
+uint32_t Px(uint32_t rgb) { return SDL_MapSurfaceRGBA(g_canvas, (rgb >> 16) & 255, (rgb >> 8) & 255, rgb & 255, 255); }
+
+void Fill(int x, int y, int w, int h, uint32_t rgb)
+{
+   if (w <= 0 || h <= 0)
+      return;
+   const SDL_Rect r = { x, y, w, h };
+   SDL_FillSurfaceRect(g_canvas, &r, Px(rgb));
+}
+
+// rounded rectangle: one span per row, inset by the corner arc
+void FillRR(int x, int y, int w, int h, int radius, uint32_t rgb)
+{
+   radius = std::min(radius, std::min(w, h) / 2);
+   for (int row = 0; row < h; row++) {
+      int inset = 0;
+      const int edge = row < radius ? radius - row : (row >= h - radius ? row - (h - radius) + 1 : 0);
+      if (edge > 0)
+         inset = radius - static_cast<int>(std::sqrt(static_cast<float>(radius * radius - (radius - edge) * (radius - edge)) + 0.5f));
+      Fill(x + inset, y + row, w - 2 * inset, 1, rgb);
+   }
+}
+
+TTF_Font* Font(int size, bool bold)
+{
+   static std::map<int, TTF_Font*> fonts;
+   const int key = size * 2 + (bold ? 1 : 0);
+   auto it = fonts.find(key);
+   if (it != fonts.end())
+      return it->second;
+   TTF_Font* font = nullptr;
+   if (g_fontData)
+      font = TTF_OpenFontIO(SDL_IOFromConstMem(g_fontData, g_fontSize), true, static_cast<float>(size));
+   if (font && bold)
+      TTF_SetFontStyle(font, TTF_STYLE_BOLD);
+   fonts[key] = font;
+   return font;
+}
+
+struct TextTex
+{
+   SDL_Surface* surf = nullptr;
+};
+std::unordered_map<std::string, TextTex> g_textCache;
+
+SDL_Surface* TextSurface(const std::string& s, int size, uint32_t rgb, bool bold)
+{
+   if (s.empty())
+      return nullptr;
+   const std::string key = std::to_string(size) + (bold ? "b" : "r") + std::to_string(rgb) + ":" + s;
+   auto it = g_textCache.find(key);
+   if (it != g_textCache.end())
+      return it->second.surf;
+   if (g_textCache.size() > 900) {
+      for (auto& e : g_textCache)
+         if (e.second.surf)
+            SDL_DestroySurface(e.second.surf);
+      g_textCache.clear();
+   }
+   SDL_Surface* surf = nullptr;
+   if (TTF_Font* font = Font(size, bold)) {
+      const SDL_Color c = { static_cast<Uint8>((rgb >> 16) & 255), static_cast<Uint8>((rgb >> 8) & 255), static_cast<Uint8>(rgb & 255), 255 };
+      surf = TTF_RenderText_Blended(font, s.c_str(), 0, c);
+   }
+   g_textCache[key].surf = surf;
+   return surf;
+}
+
+int TextWidth(const std::string& s, int size, bool bold)
+{
+   TTF_Font* font = Font(size, bold);
+   int w = 0, h = 0;
+   if (font && !s.empty())
+      TTF_GetStringSize(font, s.c_str(), 0, &w, &h);
+   return w;
+}
+
+// ellipsis at the end when it does not fit in maxW
+std::string Fit(const std::string& s, int size, bool bold, int maxW)
+{
+   if (maxW <= 0 || TextWidth(s, size, bold) <= maxW)
+      return s;
+   std::string t = s;
+   while (!t.empty()) {
+      do
+         t.pop_back();
+      while (!t.empty() && (static_cast<unsigned char>(t.back()) & 0xC0) == 0x80);
+      if (TextWidth(t + "...", size, bold) <= maxW)
+         return t + "...";
+   }
+   return "";
+}
+
+// align: 0 left, 1 right, 2 centre. y is the top of a line box of height lineH
+void Text(int x, int y, int lineH, const std::string& s, int size, uint32_t rgb, bool bold = false, int align = 0, int maxW = 0)
+{
+   const std::string shown = Fit(s, size, bold, maxW);
+   SDL_Surface* surf = TextSurface(shown, size, rgb, bold);
+   if (!surf)
+      return;
+   SDL_Rect dst = { x, y + (lineH - surf->h) / 2, surf->w, surf->h };
+   if (align == 1)
+      dst.x = x - surf->w;
+   else if (align == 2)
+      dst.x = x - surf->w / 2;
+   SDL_BlitSurface(surf, nullptr, g_canvas, &dst);
+}
