+static const char* kRumaAppliedFile = "/switch/vpnx/ruma_applied.json";
+
+struct RumaApplied
+{
+   std::string section, key;
+   SetKind kind;
+   double orig, wrote;
+};
+static std::map<std::string, RumaApplied> g_rumaApplied; // "Section.Key"
+
+static double LoadSetting(const char* section, const char* key, SetKind kind)
+{
+   switch (kind) {
+   case SetKind::Int: return VPinballLoadValueInt(section, key, 0);
+   case SetKind::Bool: return VPinballLoadValueBool(section, key, 0);
+   default: return VPinballLoadValueFloat(section, key, 0.f);
+   }
+}
+
+static void SaveSetting(const char* section, const char* key, SetKind kind, double value)
+{
+   switch (kind) {
+   case SetKind::Int: VPinballSaveValueInt(section, key, (int)std::lround(value)); break;
+   case SetKind::Bool: VPinballSaveValueBool(section, key, value != 0.0 ? 1 : 0); break;
+   default: VPinballSaveValueFloat(section, key, (float)value); break;
+   }
+}
+
+static bool SameSetting(SetKind kind, double a, double b)
+{
+   return kind == SetKind::Float ? std::fabs(a - b) < 1e-3 : std::lround(a) == std::lround(b);
+}
+
+// puts back what the previous Ruma session overrode (unless the player changed it since)
+static void RestoreRumaOverrides()
+{
+   FILE* f = fopen(kRumaAppliedFile, "rb");
+   if (!f)
+      return;
+   std::string text;
+   char buf[4096];
+   size_t n;
+   while ((n = fread(buf, 1, sizeof buf, f)) > 0)
+      text.append(buf, n);
+   fclose(f);
+   int restored = 0, kept = 0;
+   try {
+      const nlohmann::json j = nlohmann::json::parse(text);
+      for (const auto& [name, e] : j.items()) {
+         const std::string section = e.value("s", std::string()), key = e.value("k", std::string());
+         const int kindNum = e.value("t", 0);
+         if (section.empty() || key.empty() || kindNum < 0 || kindNum > 2)
+            continue;
+         const SetKind kind = (SetKind)kindNum;
+         const double orig = e.value("o", 0.0), wrote = e.value("w", 0.0);
+         if (SameSetting(kind, LoadSetting(section.c_str(), key.c_str(), kind), wrote)) {
+            SaveSetting(section.c_str(), key.c_str(), kind, orig);
+            restored++;
+         } else
+            kept++;
+      }
+   } catch (const std::exception& e) {
+      LOG("[ruma] bad %s: %s\n", kRumaAppliedFile, e.what());
+   }
+   remove(kRumaAppliedFile);
+   LOG("[ruma] previous overrides: %d put back, %d kept (changed in the menu)\n", restored, kept);
+}
+
+static void SaveRumaOverrides()
+{
+   if (g_rumaApplied.empty())
+      return;
+   nlohmann::json j = nlohmann::json::object();
+   for (const auto& [name, a] : g_rumaApplied)
+      j[name] = { { "s", a.section }, { "k", a.key }, { "t", (int)a.kind }, { "o", a.orig }, { "w", a.wrote } };
+   if (FILE* f = fopen(kRumaAppliedFile, "wb")) {
+      const std::string text = j.dump(1);
+      fwrite(text.data(), 1, text.size(), f);
+      fclose(f);
+   }
+}
+
+static void SetRumaSetting(const RumaSettingRef& t, double value)
+{
+   const double current = LoadSetting(t.section, t.key, t.kind);
+   if (SameSetting(t.kind, current, value))
+      return; // already what the table wants: nothing to write, nothing to put back later
+   const std::string name = std::string(t.section) + "." + t.key;
+   const auto it = g_rumaApplied.find(name);
+   if (it == g_rumaApplied.end())
+      g_rumaApplied[name] = { t.section, t.key, t.kind, current, value };
+   else
+      it->second.wrote = value;
+   SaveSetting(t.section, t.key, t.kind, value);
+   LOG("[ruma] %s = %g (was %g)\n", name.c_str(), value, current);
+}
+
+static void ApplyRumaOptions()
+{
+   RestoreRumaOverrides(); // also when started by hand: the settings go back to what the menu / ini say
+   if (!g_ruma.active)
+      return;
+   for (const RumaOptionMap& m : kRumaOptionMaps) {
+      const std::string chosen = RumaOption(m.id, "auto");
+      if (chosen.empty() || chosen == "auto")
+         continue;
+      const RumaOptionValue* v = nullptr;
+      for (const RumaOptionValue& c : m.values)
+         if (chosen == c.value) {
+            v = &c;
+            break;
+         }
+      if (!v) {
+         LOG("[ruma] option %s: unknown value '%s' ignored\n", m.id, chosen.c_str());
+         continue;
+      }
+      for (size_t i = 0; i < m.targets.size(); i++)
+         SetRumaSetting(m.targets[i], v->nums.size() == 1 ? v->nums[0] : (i < v->nums.size() ? v->nums[i] : 0.0));
+   }
+   // the shell's own "Show FPS" (video group of Ruma's settings) turns the FPS overlay on when the table has no choice of its own
+   if (RumaOption("fps_overlay", "auto") == "auto" && RumaOption("show_fps", "false") == "true")
+      SetRumaSetting({ "Player", "ShowFPS", SetKind::Int }, 1.0);
+   SaveRumaOverrides();
+   LOG("[ruma] %zu setting(s) overridden for this table; clock=%s\n", g_rumaApplied.size(), RumaOption("clock", "default").c_str());
+}
+
+// the clocks found at start, put back on exit: the loader and the next application must not inherit the boost
+static struct { PcvModuleId id; u32 hz; } g_savedClocks[3];
+static int g_savedClockCount = 0;
+static bool g_clkrstOpen = false;
+static bool g_socketOpen = false;
+
+static void RestoreClockProfile()
+{
+   if (!g_clkrstOpen)
+      return;
+   for (int i = 0; i < g_savedClockCount; i++) {
+      ClkrstSession session;
+      if (R_FAILED(clkrstOpenSession(&session, g_savedClocks[i].id, 3)))
+         continue;
+      clkrstSetClockRate(&session, g_savedClocks[i].hz);
+      clkrstCloseSession(&session);
+   }
+   g_savedClockCount = 0;
+   clkrstExit();
+   g_clkrstOpen = false;
+}
+
+// Leave the way the launcher asked: back to Ruma when it started this app. The player is closed first (all its threads stopped),
+// then _exit hands over to the loader, which starts the NRO set by envSetNextLoad.
+static std::string g_selfPath;     // this NRO, to come back to the table list
+static bool g_backToList = false;  // standalone: the exit gesture returns to the list instead of leaving the VPNX
+static std::string g_playedTable; // the table being played (standalone), for the statistics
+static time_t g_playStart = 0;
+
+static void ExitToLauncher()
+{
+   if (g_ruma.active && !g_ruma.returnNro.empty()) {
+      LOG("[ruma] back to %s\n", g_ruma.returnNro.c_str());
+      envSetNextLoad(g_ruma.returnNro.c_str(), g_ruma.returnArgv.empty() ? g_ruma.returnNro.c_str() : g_ruma.returnArgv.c_str());
+   }
+   // stop our own thread, then leave through the regular exit: libnx hands control to the loader (hbmenu, or the NRO set above).
+   // _exit skipped that and the loader itself crashed (hbl, 2168-0001).
+   if (!g_ruma.active && !g_playedTable.empty() && g_playStart > 0) {
+      FrontendRecordPlay(g_playedTable, static_cast<long>(time(nullptr) - g_playStart));
+      g_playedTable.clear();
+   }
+   // every thread must be gone before the loader takes the process over (SDL's audio and timer threads outlive the player)
+   if (SDL_WasInit(0))
+      SDL_Quit();
+   if (g_backToList && !g_ruma.active) {
+      // the NRO to start again: this one when it is a file (started from hbmenu), else the installed copy (a netloaded NRO is not on the SD)
+      const char* self = access(g_selfPath.c_str(), F_OK) == 0 ? g_selfPath.c_str() : "/switch/vpnx/vpnx.nro";
+      LOG("[exit] back to the table list: %s (argv0 %s)\n", self, g_selfPath.c_str());
+      if (access(self, F_OK) == 0) {
+         // --back: the browser skips the splash, which is for a cold start only
+         const std::string args = std::string("\"") + self + "\" --back";
+         envSetNextLoad(self, args.c_str());
+      }
+   }
+   RestoreClockProfile();
+   if (g_socketOpen) {
+      // stdout/stderr may be the nxlink socket: hand them back to a file while the socket service is still alive, so that nothing
+      // closes or flushes a socket descriptor after socketExit
+      freopen("/switch/vpnx/stdio.log", "a", stdout);
+      freopen("/switch/vpnx/stdio.log", "a", stderr);
+      socketExit();
+      g_socketOpen = false;
+   }
+   g_watchdogStop = true;
+   if (g_watchdogStarted) {
+      threadWaitForExit(&g_watchdog);
+      threadClose(&g_watchdog);
+   }
+   if (g_logFile)
+      fclose(g_logFile);
+   g_logFile = nullptr;
+   exit(0);
+}
+
+// Clock profile. A homebrew launch runs at the stock clocks (CPU 1020 MHz, GPU 307.2 MHz), which is far below what the
+// console does for commercial games and left this port CPU/GPU starved. The default profile uses frequencies of the console's
+// own tables that official software runs at, per operation mode:
+//   handheld: CPU 1785, GPU 460.8, EMC 1600 MHz      docked: CPU 1785, GPU 768, EMC 1600 MHz
+// sdmc:/switch/vpnx/noboost.txt keeps the stock clocks; boostmax.txt asks for the top GPU step (921.6 MHz) for comparisons.
+static void ApplyClockProfile()
+{
+   LOG("[mesa] glthread=%s no_error=%s\n", getenv("mesa_glthread") ? getenv("mesa_glthread") : "off", getenv("MESA_NO_ERROR") ? getenv("MESA_NO_ERROR") : "off");
+   const std::string clockOpt = RumaOption("clock", "default");
+   if (clockOpt == "stock" || access("/switch/vpnx/noboost.txt", F_OK) == 0) {
+      LOG("[clocks] stock clocks (noboost.txt)\n");
+      return;
+   }
+   if (R_FAILED(clkrstInitialize())) {
+      LOG("[clocks] clkrst unavailable\n");
+      return;
+   }
+   g_clkrstOpen = true;
+   const bool docked = appletGetOperationMode() == AppletOperationMode_Console;
+   const bool maxGpu = clockOpt == "max" || access("/switch/vpnx/boostmax.txt", F_OK) == 0;
+   const u32 gpuHz = maxGpu ? 921600000u : (docked ? 768000000u : 460800000u);
+   LOG("[clocks] %s mode, profile %s\n", docked ? "docked" : "handheld", maxGpu ? "boostmax" : "default");
+   const struct { PcvModuleId id; u32 hz; const char* name; } mods[] = {
+      { PcvModuleId_CpuBus, 1785000000u, "CPU" }, { PcvModuleId_GPU, gpuHz, "GPU" }, { PcvModuleId_EMC, 1600000000u, "EMC" },
+   };
+   for (const auto& m : mods) {
+      ClkrstSession session;
+      u32 before = 0, after = 0;
+      if (R_FAILED(clkrstOpenSession(&session, m.id, 3)))
+         continue;
+      clkrstGetClockRate(&session, &before);
+      if (g_savedClockCount < 3 && before)
+         g_savedClocks[g_savedClockCount++] = { m.id, before };
+      const Result rc = clkrstSetClockRate(&session, m.hz);
+      clkrstGetClockRate(&session, &after);
+      LOG("[clocks] %s %u -> %u Hz (requested %u, rc=0x%x)\n", m.name, before, after, m.hz, rc);
+      clkrstCloseSession(&session);
+   }
+}
+
+static const char* kTablesDir = "/switch/vpnx";
+
+static void LogMemory(const char* tag)
+{
+   u64 total = 0, used = 0;
+   svcGetInfo(&total, InfoType_TotalMemorySize, CUR_PROCESS_HANDLE, 0);
+   svcGetInfo(&used, InfoType_UsedMemorySize, CUR_PROCESS_HANDLE, 0);
+   LOG("[mem] %s: used %lu MiB of %lu MiB\n", tag, (unsigned long)(used >> 20), (unsigned long)(total >> 20));
+}
+
+static void OnEvent(VPINBALL_EVENT event, const char* data)
+{
+   // progress events fire hundreds of times (and each LOG goes over the nxlink socket): only report changes
+   if (event == 2 && data) {
+      static std::string last;
+      if (last == data)
+         return;
+      last = data;
+      LOG("[vpx event 2] %s\n", data);
+      LogMemory("load");
+      return;
+   }
+   LOG("[vpx event %d] %s\n", (int)event, data ? data : "");
+}
+
+static std::string FindTable()
+{
+   std::string found;
+   if (DIR* dir = opendir(kTablesDir)) {
+      while (const dirent* e = readdir(dir)) {
+         const size_t n = strlen(e->d_name);
+         if (n > 4 && strcasecmp(e->d_name + n - 4, ".vpx") == 0) {
+            found = std::string(kTablesDir) + "/" + e->d_name;
+            break;
+         }
+      }
+      closedir(dir);
+   }
+   return found;
+}
+
+// First-run defaults for the DMD: the ScoreView plugin draws the score display into the playfield window (embedded), small, in the
+// top right corner. Written only when absent, so a value edited in the menu or the ini is kept.
+static void ApplyDisplayDefaults()
+{
+   // a value read back is the property's default when absent, so "was it set" is told by a marker file: the defaults go in once,
+   // after that what the menu or the ini says is kept (delete sdmc:/switch/vpnx/dmd_defaults.txt to apply them again)
+   if (access("/switch/vpnx/dmd_defaults.txt", F_OK) != 0) {
+      VPinballSaveValueInt("Plugin.ScoreView", "Enable", 1);
+      VPinballSaveValueInt("ScoreView", "ScoreViewOutput", 2); // embedded in the playfield window
+      VPinballSaveValueInt("ScoreView", "ScoreViewWndX", 940);
+      VPinballSaveValueInt("ScoreView", "ScoreViewWndY", 12);
+      VPinballSaveValueInt("ScoreView", "ScoreViewWidth", 328);
+      VPinballSaveValueInt("ScoreView", "ScoreViewHeight", 96);
+      if (FILE* f = fopen("/switch/vpnx/dmd_defaults.txt", "w")) {
+         fputs("ScoreView defaults applied once; delete this file to apply them again\n", f);
+         fclose(f);
+      }
+   }
+   LOG("[dmd] ScoreView enable=%d output=%d rect=%d,%d %dx%d\n", VPinballLoadValueInt("Plugin.ScoreView", "Enable", -1), VPinballLoadValueInt("ScoreView", "ScoreViewOutput", -1),
+      VPinballLoadValueInt("ScoreView", "ScoreViewWndX", -1), VPinballLoadValueInt("ScoreView", "ScoreViewWndY", -1), VPinballLoadValueInt("ScoreView", "ScoreViewWidth", -1),
+      VPinballLoadValueInt("ScoreView", "ScoreViewHeight", -1));
+}
+
+int main(int argc, char** argv)
+{
+   g_logFile = fopen("/switch/vpnx/vpinball.log", "w");
+   LOG("vpinball main() entered\n");
+   // arguments: Ruma starts "{nro} --rom <table> --session <file>"; started by hand, the last argument (or the first .vpx found) is the table
+   std::string argTable;
+   bool cameBack = false;
+   if (argc > 0 && argv[0])
+      g_selfPath = argv[0];
+   for (int i = 1; i < argc; i++) {
+      if (!strcmp(argv[i], "--session") && i + 1 < argc)
+         LoadRumaSession(argv[++i]);
+      else if (!strcmp(argv[i], "--rom") && i + 1 < argc)
+         argTable = argv[++i];
+      else if (!strcmp(argv[i], "--back"))
+         cameBack = true;
+      else if (argv[i][0] != '-')
+         argTable = argv[i];
+   }
+   // the standalone table list needs the screen console, so it runs before nxlink takes over stdout
+   if (!g_ruma.active && argTable.empty()) {
+      argTable = FrontendRun(!cameBack, g_selfPath);
+      // the options chosen in the browser stand in for the ones Ruma's session would carry
+      for (const auto& [k, v] : FrontendOptions())
+         g_ruma.options[k] = v;
+      if (argTable.empty()) {
+         LOG("no table chosen\n");
+         ExitToLauncher();
+      }
+   }
+   // the table list's console is gone, but stdout and stderr still point at it. nxlink (when it connects in time, its listener gives up
+   // after a few seconds) takes them over; otherwise anything printed would hit the freed framebuffer. Park them in a file first.
+   freopen("/switch/vpnx/stdio.log", "w", stdout);
+   freopen("/switch/vpnx/stdio.log", "a", stderr);
+   g_socketOpen = R_SUCCEEDED(socketInitializeDefault());
+   nxlinkConnectToHost(true, true); // stdout too: vpinball's PLOG console output
+   setvbuf(stdout, nullptr, _IONBF, 0);
+   setvbuf(stderr, nullptr, _IONBF, 0);
+   LOG("vpinball for Switch: libvpinball %s\n", VPinballGetVersionStringFull());
+
+   std::set_terminate(TerminateHandler);
+   // Mesa tuning for the GL submit cost (~40 us per draw call on the A57): run the GL commands on a driver thread and skip
+   // the per-call error checking. sdmc:/switch/vpnx/noglthread.txt turns the thread off to compare.
+   if (access("/switch/vpnx/noglthread.txt", F_OK) != 0)
+      setenv("mesa_glthread", "true", 1);
+   setenv("MESA_NO_ERROR", "1", 1);
+   // nxvk (Mesa's NVK): the Tegra X1 GPU is not Vulkan conformant and NVK hides it, exposing zero physical devices, unless
+   // asked explicitly. Harmless in the OpenGL ES build.
+   setenv("NVK_I_WANT_A_BROKEN_VULKAN_DRIVER", "1", 1);
+   ApplyClockProfile();
+   if (R_SUCCEEDED(threadCreate(&g_watchdog, WatchdogThread, nullptr, nullptr, 0x10000, 0x2C, -2)))
+      g_watchdogStarted = R_SUCCEEDED(threadStart(&g_watchdog));
+   SDL_SetMainReady();
+   VPinballInit(&OnEvent, nullptr);
+   ApplyDisplayDefaults();
+   ApplyRumaOptions();
+   if (SDL_AppInit(nullptr, argc, argv) != SDL_APP_CONTINUE) {
+      LOG("SDL_AppInit failed: %s\n", SDL_GetError());
+      ExitToLauncher();
+   }
+   for (int p : { (int)VPINBALL_PATH_ROOT, (int)VPINBALL_PATH_TABLES, (int)VPINBALL_PATH_PREFERENCES, (int)VPINBALL_PATH_ASSETS })
+      LOG("path %d: %s\n", p, VPinballGetPath((VPINBALL_PATH)p));
+
+   std::string table = g_ruma.active ? g_ruma.rom : (!argTable.empty() ? argTable : FindTable());
+   if (table.empty()) {
+      LOG("no .vpx table found in %s\n", kTablesDir);
+      ExitToLauncher();
+   }
+   g_playedTable = table;
+   g_playStart = time(nullptr);
+   LOG("loading %s\n", table.c_str());
+   if (VPinballLoadTable(table.c_str()) != VPINBALL_STATUS_SUCCESS) {
+      LOG("VPinballLoadTable failed\n");
+      ExitToLauncher();
+   }
+   LOG("playing\n");
+   if (VPinballPlay() != VPINBALL_STATUS_SUCCESS) {
+      LOG("VPinballPlay failed\n");
+      ExitToLauncher();
+   }
+   // the player is stepped from SDL_AppIterate until it closes. ZL+ZR+- (the launcher's overlay combo) closes the table and goes back
+   // to Ruma when it started this app; standalone, + and - together (or the same combo) go back to the table list, where + leaves the
+   // VPNX. The - key alone stays the player's menu. HOME always works.
+   PadState exitPad;
+   padConfigureInput(1, HidNpadStyleSet_NpadStandard);
+   padInitializeDefault(&exitPad);
+   const u64 exitCombo = HidNpadButton_ZL | HidNpadButton_ZR | HidNpadButton_Minus;
+   const u64 exitComboAlt = HidNpadButton_Plus | HidNpadButton_Minus; // standalone only
+   u64 exitHeldSince = 0;
+   bool exitRequested = false;
+   while (appletMainLoop()) {
+      padUpdate(&exitPad);
+      const u64 held = padGetButtons(&exitPad);
+      if ((held & exitCombo) == exitCombo || (!g_ruma.active && (held & exitComboAlt) == exitComboAlt)) {
+         if (exitHeldSince == 0)
+            exitHeldSince = armGetSystemTick();
+         else if (armTicksToNs(armGetSystemTick() - exitHeldSince) > 400000000ull && !exitRequested) {
+            LOG("[exit] exit combo held: closing the table\n");
+            exitRequested = true;
+            g_backToList = true;
+            VPinballStop();
+         }
+      } else
+         exitHeldSince = 0;
+      SDL_Event ev;
+      while (SDL_PollEvent(&ev)) {
+         if (ev.type == SDL_EVENT_JOYSTICK_BUTTON_DOWN || ev.type == SDL_EVENT_JOYSTICK_BUTTON_UP)
+            LOG("[pad] joy %u button %u %s\n", (unsigned)ev.jbutton.which, (unsigned)ev.jbutton.button, ev.jbutton.down ? "down" : "up");
+         else if (ev.type == SDL_EVENT_JOYSTICK_AXIS_MOTION && (ev.jaxis.value > 20000 || ev.jaxis.value < -20000))
+            LOG("[pad] joy %u axis %u = %d\n", (unsigned)ev.jaxis.which, (unsigned)ev.jaxis.axis, (int)ev.jaxis.value);
+         SDL_AppEvent(nullptr, &ev);
+      }
+      // Each iteration advances the physics, polls the inputs and fires the script's controller-sync timers (PinMameTimer...).
+      // Spun without pause, the loop ran ~900 times per rendered frame: ~44 ms/frame of VBScript calls and one of the three
+      // usable cores at 100%, fighting the PinMAME, audio and render threads. The physics ticks at 1 kHz, so pace it to that.
+      const u64 iterStart = armGetSystemTick();
+      SDL_AppIterate(nullptr);
+      const u64 iterNs = armTicksToNs(armGetSystemTick() - iterStart);
+      if (iterNs < 1000000ull)
+         svcSleepThread((s64)(1000000ull - iterNs));
+      // frame timing report every 3 s (to tell a CPU-bound from a GPU-bound table). Between 60 s and 90 s of play the profilers
+      // are not restarted so the slowest frames accumulate, and at 90 s they are logged with the time spent in each script event.
+      static const u64 playStart = armGetSystemTick();
+      static u64 lastPerf = playStart;
+      static bool worstLogged = false;
+      const u64 now = armGetSystemTick();
+      if (armTicksToNs(now - lastPerf) > 3000000000ull) {
+         lastPerf = now;
+         const double playSec = armTicksToNs(now - playStart) / 1e9;
+         const bool accumulate = playSec > 60.0 && playSec < 90.0;
+         // the worst frames must be logged before the summary, as the summary restarts the profilers
+         if (playSec >= 90.0 && !worstLogged) {
+            worstLogged = true;
+            VPinballLogWorstFrames();
+         }
+         if (const char* perf = VPinballGetPerfSummary(accumulate ? 0 : 1); perf && *perf)
+            LOG("[perf] %s\n", perf);
+      }
+      if (!VPinballIsPlaying())
+         break;
+   }
+   LOG("done\n");
+   g_backToList = true; // the table ended (the player's own + quit, or the gesture): standalone goes back to the list
+   ExitToLauncher(); // does not return
+}
