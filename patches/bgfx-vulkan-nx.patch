+// Nintendo Switch: the Vulkan driver (nxvk, Mesa's NVK) is linked statically, there is no libvulkan to dlopen and no
+// loader. Its entry point is the ICD one, and the few functions the loader normally provides are stood in for here.
+extern "C" PFN_vkVoidFunction VKAPI_CALL vk_icdGetInstanceProcAddr(VkInstance _instance, const char* _name);
+
+namespace bgfx { namespace vk
+{
+	static VkInstance s_nxInstance = VK_NULL_HANDLE;
+
+	static PFN_vkVoidFunction VKAPI_CALL nxGetDeviceProcAddr(VkDevice _device, const char* _name)
+	{
+		// vkGetDeviceProcAddr itself is an instance level function of the ICD
+		PFN_vkGetDeviceProcAddr getDeviceProcAddr = (PFN_vkGetDeviceProcAddr)vk_icdGetInstanceProcAddr(s_nxInstance, "vkGetDeviceProcAddr");
+		return NULL != getDeviceProcAddr ? getDeviceProcAddr(_device, _name) : NULL;
+	}
+
+	static VkResult VKAPI_CALL nxEnumerateInstanceLayerProperties(uint32_t* _count, VkLayerProperties*)
+	{
+		*_count = 0; // layers are a loader feature
+		return VK_SUCCESS;
+	}
+
+	static void* nxLoaderSymbol(const char* _name)
+	{
+		if (0 == bx::strCmp(_name, "vkGetInstanceProcAddr") )           { return (void*)vk_icdGetInstanceProcAddr; }
+		if (0 == bx::strCmp(_name, "vkGetDeviceProcAddr") )             { return (void*)nxGetDeviceProcAddr; }
+		if (0 == bx::strCmp(_name, "vkEnumerateInstanceLayerProperties") ) { return (void*)nxEnumerateInstanceLayerProperties; }
+		return (void*)vk_icdGetInstanceProcAddr(VK_NULL_HANDLE, _name);
+	}
+} }
+#endif // BX_PLATFORM_NX
